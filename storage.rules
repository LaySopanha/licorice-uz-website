rules_version = '2';

// NOTE: Product and gallery image uploads use SUPABASE Storage, not Firebase
// Storage (see src/supabase/config.js). These rules simply lock down the
// Firebase Storage bucket so it cannot be used as an open file dump.
//
// Supabase bucket policies must be configured separately in the Supabase
// dashboard (Storage → Policies):
//   - buckets `products` and `gallery`: public READ, authenticated WRITE.

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if false;
      allow write: if request.auth != null;
    }
  }
}
