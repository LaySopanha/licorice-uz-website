# Copy this file to .env and fill in the values before running locally.

# ─── Firebase (Firestore data + Auth) ──────────────────────────────────────
# Firebase Console → Project Settings → Your Apps → SDK setup
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─── Supabase (image storage for products + gallery) ───────────────────────
# Supabase Dashboard → Project Settings → API
# Buckets `products` and `gallery` must exist (public read, authenticated write).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── EmailJS (contact + price inquiry emails) ──────────────────────────────
# Dashboard: https://dashboard.emailjs.com/
# Service/template/public-key defaults live in src/config.js; override here if needed.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_CONTACT_TEMPLATE_ID=
VITE_EMAILJS_PRICE_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Auto-reply template — create a template where:
#   To Email = {{to_email}}
#   Subject  = "Thank you for your inquiry | Bogot Master"
#   Body     = use the text in src/services/emailService.js as a guide
VITE_EMAILJS_AUTO_REPLY_TEMPLATE_ID=
