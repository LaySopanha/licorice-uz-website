# Firebase project config — copy to .env and fill in values
# Get from Firebase Console → Project Settings → Your Apps → SDK setup

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# EmailJS auto-reply template ID
# Create a template in EmailJS dashboard where:
#   To Email = {{to_email}}
#   Subject  = "Thank you for your inquiry | Bogot Master"
#   Body     = use the text in src/services/emailService.js as a guide
VITE_EMAILJS_AUTO_REPLY_TEMPLATE_ID=
